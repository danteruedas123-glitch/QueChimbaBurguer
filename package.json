{
  "name": "quechimba-pedidos",
  "productName": "Quechimba Pedidos",
  "version": "1.5.1",
  "description": "Pedidos, menú y contabilidad de Quechimba Burger",
  "type": "module",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/db/*.test.js\"",
    "test:web": "node --test \"tests/web/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.test.js\"",
    "test:todo": "npm test && npm run test:web && npm run test:e2e",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "release:linux": "electron-builder --linux deb --x64 --arm64 --publish always",
    "test:mutacion": "node tests/mutacion.mjs",
    "test:estres": "node --test --test-concurrency=1 \"tests/estres/*.test.js\"",
    "sql:unificar": "node scripts/unificar-sql.mjs",
    "menu:generar": "node scripts/generar-menu.mjs && node scripts/unificar-sql.mjs",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "puppeteer-core": "^25.16.0"
  },
  "author": {
    "name": "Halan Santiago",
    "email": "noreply@users.noreply.github.com"
  },
  "build": {
    "appId": "com.quechimbaburger.pedidos",
    "productName": "Quechimba Pedidos",
    "copyright": "Quechimba Burger",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "supabase/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Quechimba-Pedidos-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quechimba Pedidos",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "danteruedas123-glitch",
        "repo": "QueChimbaBurguer",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "quechimba-pedidos",
      "synopsis": "Pedidos, menú y contabilidad de Quechimba Burger",
      "maintainer": "Halan Santiago <noreply@users.noreply.github.com>",
      "artifactName": "Quechimba-Pedidos-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Quechimba Pedidos",
          "StartupWMClass": "Quechimba Pedidos"
        }
      }
    },
    "deb": {
      "packageName": "quechimba-pedidos",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1",
        "libdrm2"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://quechimbaburguer.netlify.app/"
}
